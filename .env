# Copy this file to .env and paste your own Stripe TEST keys.
# Get them from https://dashboard.stripe.com/test/apikeys (Developers > API keys, Test mode on)

# Publishable key: used by the React app, so it needs the VITE_ prefix
VITE_STRIPE_PUBLISHABLE_KEY=

# Secret key: used ONLY by server/index.js. Never add VITE_ to it and never commit .env
STRIPE_SECRET_KEY=
